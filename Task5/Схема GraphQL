Ну с учетом того, что из задания в документе Swagger JSON у клиента инфа только о
1. Информацию о клиенте по ID самого клиента
2. Информация о документах клиента по ID самого клиента
3. И о родственника клиента по ID самого клиента

Все идет в такую структуру:
type Query {
  client(id: ID!): Client
}

type Client {
  id: ID!
  name: String
  age: Int
  documents: [Document]
  relatives: [Relative]
}

type Document {
  id: ID!
  type: String
  number: String
  issueDate: String
  expiryDate: String
}

type Relative {
  id: ID!
  relationType: String
  name: String
  age: Int
}